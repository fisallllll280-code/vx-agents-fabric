{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.invalid/schemas/system-language-registry.schema.json",
  "title": "VAIXLNS System Language Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "status", "canonical_authority", "orchestrator", "assurance_gate", "canonical_source_rule", "policy", "languages"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["VERIFIED", "SPECIFIED", "PARTIAL", "MISSING", "CONFLICT", "PROPOSAL"]},
    "canonical_authority": {"const": "VAIXLNS"},
    "orchestrator": {"const": "VX"},
    "assurance_gate": {"const": "ARC-X"},
    "canonical_source_rule": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["default_mode", "unknown_language_action", "missing_parser_action", "missing_semantics_or_compiler_action", "execute_source_code", "network_access", "canonical_mutation", "delete_or_overwrite_historical_artifacts", "require_source_hash", "require_reproducible_tests_before_verified", "preserve_original_derived_superseded_active_lineage"],
      "properties": {
        "default_mode": {"const": "READ_ONLY"},
        "unknown_language_action": {"const": "HOLD"},
        "missing_parser_action": {"const": "HOLD_ADAPTER_NOT_CONFIGURED"},
        "missing_semantics_or_compiler_action": {"const": "HOLD"},
        "execute_source_code": {"const": false},
        "network_access": {"const": false},
        "canonical_mutation": {"const": false},
        "delete_or_overwrite_historical_artifacts": {"const": false},
        "require_source_hash": {"const": true},
        "require_reproducible_tests_before_verified": {"const": true},
        "preserve_original_derived_superseded_active_lineage": {"const": true}
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language_id", "version", "display_name", "grammar", "source_status", "canonical_ref", "reference_state", "parser_adapter", "semantic_adapter", "compiler_adapter", "required_root_keys", "capabilities", "allowed_targets", "notes"],
        "properties": {
          "language_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,95}$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
          "display_name": {"type": "string", "minLength": 1},
          "grammar": {"enum": ["json", "python_ast", "math_expression", "markdown", "yaml", "unresolved"]},
          "source_status": {"enum": ["VERIFIED", "SPECIFIED", "PARTIAL", "MISSING", "CONFLICT", "PROPOSAL"]},
          "canonical_ref": {"type": "string", "minLength": 1},
          "reference_state": {"type": "string", "minLength": 1},
          "parser_adapter": {"type": ["string", "null"]},
          "semantic_adapter": {"type": ["string", "null"]},
          "compiler_adapter": {"type": ["string", "null"]},
          "required_root_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}